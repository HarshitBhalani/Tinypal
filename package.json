{
  "name": "tinypal-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Tinypal (Context Mascot): an event-driven mascot SDK monorepo",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/basic-react",
    "examples/form-validation",
    "examples/api-interactions"
  ],
  "scripts": {
    "dev": "npm run dev -w @tinypal/website",
    "build:website": "npm run build -w @tinypal/website",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:package": "npm run build -w tinypal",
    "pack:check": "npm run build -w tinypal && npm pack -w tinypal --dry-run",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "axios": "^1.21.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HarshitBhalani/Tinypal.git"
  },
  "homepage": "https://github.com/HarshitBhalani/Tinypal#readme",
  "bugs": {
    "url": "https://github.com/HarshitBhalani/Tinypal/issues"
  }
}
