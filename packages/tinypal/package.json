{
  "name": "tinypal",
  "version": "0.1.1",
  "description": "An interactive mascot SDK for React that reacts to forms, API calls, inactivity and the cursor.",
  "keywords": [
    "mascot",
    "react",
    "companion",
    "animation",
    "svg",
    "character",
    "forms",
    "ux",
    "typescript"
  ],
  "license": "MIT",
  "author": "HarshitBhalani",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HarshitBhalani/Tinypal.git",
    "directory": "packages/tinypal"
  },
  "homepage": "https://tinypal-rose.vercel.app/",
  "bugs": {
    "url": "https://github.com/HarshitBhalani/Tinypal/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup && node scripts/copy-files.mjs",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "engines": {
    "node": ">=18"
  }
}
