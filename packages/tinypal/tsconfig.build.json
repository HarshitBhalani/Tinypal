{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "paths": {
      "@tinypal/core": ["../core/src/index.ts"],
      "@tinypal/characters": ["../characters/src/index.ts"],
      "@tinypal/adapters": ["../adapters/src/index.ts"],
